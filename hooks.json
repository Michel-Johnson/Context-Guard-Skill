{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/context_guard_hook.py session-start --platform codex",
            "timeout": 20,
            "statusMessage": "Initializing context folder"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/context_guard_hook.py subagent-start --platform codex",
            "timeout": 10,
            "statusMessage": "Initializing folder context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/context_guard_hook.py user-prompt-submit --platform codex",
            "timeout": 10,
            "statusMessage": "Recording durable user wording"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*(write|edit|delete|move).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/context_guard_hook.py pre-tool-use --platform codex",
            "timeout": 20,
            "statusMessage": "Preparing cloud development window"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/context_guard_hook.py permission-request --platform codex",
            "timeout": 10,
            "statusMessage": "Checking Context Guard node scope"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*(write|edit|delete|move).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/context_guard_hook.py post-tool-use --platform codex",
            "timeout": 20,
            "statusMessage": "Recording cloud development scope"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/context_guard_hook.py pre-compact --platform codex",
            "timeout": 10,
            "statusMessage": "Saving Context Guard plan state"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/context_guard_hook.py post-compact --platform codex",
            "timeout": 10,
            "statusMessage": "Restoring Context Guard map state"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/context_guard_hook.py subagent-stop --platform codex",
            "timeout": 10,
            "statusMessage": "Reviewing subagent scope and evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/context_guard_hook.py stop --platform codex",
            "timeout": 10,
            "statusMessage": "Checking Map archive and plan completion"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/context_guard_hook.py interrupt --platform codex",
            "timeout": 3,
            "statusMessage": "Saving interrupted Context Guard state"
          }
        ]
      }
    ]
  }
}
