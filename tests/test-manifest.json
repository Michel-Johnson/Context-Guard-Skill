{
  "schemaVersion": 1,
  "automaticNodeTests": {
    "roots": [
      ".github/scripts",
      "tests"
    ],
    "suffix": ".test.mjs",
    "excluded": [
      ".github/scripts/security-checks.test.mjs"
    ]
  },
  "standaloneSuites": [
    {
      "path": "tests/cursor-chat-browser.mjs",
      "command": "npm run test:cursor-browser",
      "purpose": "Real Chromium verifies Cursor conversation UI; native provider responses are synthetic."
    },
    {
      "path": ".github/scripts/security-checks.test.mjs",
      "command": "npm run security:test",
      "purpose": "Runs before the shared Node test process so repository security failures stop immediately."
    },
    {
      "path": "tests/ci-smoke.mjs",
      "command": "npm test",
      "purpose": "Exercises the packaged CLI and cross-runtime smoke contract."
    },
    {
      "path": "tests/workbench-browser.mjs",
      "command": "npm run test:browser",
      "purpose": "Runs the local workbench end-to-end browser acceptance suite."
    },
    {
      "path": "tests/workbench-journal-recovery-browser.mjs",
      "command": "npm run test:browser",
      "purpose": "Confirms that an explicit human action recovers a corrupt journal without replacing the current map."
    }
  ],
  "helpers": [
    {
      "path": "tests/helpers/openclaw-map.mjs",
      "usedBy": "tests/map-architecture-reading.test.mjs"
    },
    {
      "path": "tests/hook-test-helpers.mjs",
      "usedBy": "tests/hook-lifecycle.test.mjs"
    },
    {
      "path": "tests/crash-worker.mjs",
      "usedBy": "tests/workbench-sync.test.mjs"
    },
    {
      "path": "tests/win-file-lock.py",
      "usedBy": "tests/workbench-sync.test.mjs"
    },
    {
      "path": "tests/fixtures/workbench-fixtures.js",
      "usedBy": "tests/workbench-browser.mjs"
    }
  ],
  "separatePackages": [],
  "productFiles": [
    "tests/coordinator-path.test.mjs",
    "tests/map-beta.test.mjs",
    "tests/map-graph-view.test.mjs",
    "tests/map-graph-fixtures.test.mjs",
    "tests/map-architecture-reading.test.mjs",
    "tests/helpers/openclaw-map.mjs",
    "tests/cursor-chat-browser.mjs",
    "tests/doctor.test.mjs",
    "tests/executor-context.test.mjs",
    "tests/browser-login.test.mjs",
    "tests/build-runtime.test.mjs",
    "tests/claude-runtime.test.mjs",
    "tests/cursor-acp.test.mjs",
    "tests/cursor-runtime.test.mjs",
    "tests/cursor-protocol.test.mjs",
    "tests/interface-delivery.test.mjs",
    "tests/interface-map.test.mjs",
    "tests/interface-protocol.test.mjs",
    "tests/interface-repository.test.mjs",
    "tests/interface-transport.test.mjs",
    "tests/ci-smoke.mjs",
    "tests/cloud-sync-client.test.mjs",
    "tests/workbench-sync.test.mjs",
    "tests/workbench-inbox.test.mjs",
    "tests/workbench-dead-peer.test.mjs",
    "tests/hook-lifecycle.test.mjs",
    "tests/hook-records.test.mjs",
    "tests/hook-test-helpers.mjs",
    "tests/hook-runtime-concurrency.test.mjs",
    "tests/named-workbench.test.mjs",
    "tests/test-manifest.json",
    "tests/workbench-browser.mjs",
    "tests/workbench-journal-recovery.test.mjs",
    "tests/workbench-journal-recovery-browser.mjs",
