{
  "name": "@michelj/context-guard",
  "version": "0.4.4",
  "description": "Install and run Context Guard for Codex, Cursor, and Claude.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michel-Johnson/Context-Guard-Skill.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "context-guard-skill": "bin/context-guard-skill.js",
    "context-guard": "bin/context-guard-skill.js"
  },
  "files": [
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses/",
    "SKILL.md",
    "hooks.json",
    "agents/",
    "bin/",
    "prototype/",
    "references/",
    "scripts/context_guard.py",
    "scripts/context_guard_hook.py",
    "scripts/map_owns.py",
    "scripts/cloud/",
    "scripts/sync/",
    "scripts/workbench/"
  ],
  "scripts": {
    "postinstall": "node bin/postinstall.js",
    "test": "node .github/scripts/security-checks.test.mjs && node .github/scripts/verify-workflows.mjs && node --test .github/scripts/client-protocol.test.mjs .github/scripts/cli-python.test.mjs tests/cloud-workbench.test.mjs tests/cloud-sync-client.test.mjs tests/session-maps.test.mjs tests/workbench-sync.test.mjs tests/workbench-inbox.test.mjs tests/hook-lifecycle.test.mjs tests/named-workbench.test.mjs && node tests/ci-smoke.mjs",
    "security:setup": "node .github/scripts/security-tool.mjs",
    "security:test": "node .github/scripts/security-checks.test.mjs",
    "security:staged": "node .github/scripts/security-scan.mjs staged",
    "security:audit": "node .github/scripts/security-scan.mjs audit",
    "hooks:install": "node .github/scripts/security-hooks.mjs install",
    "hooks:status": "node .github/scripts/security-hooks.mjs status",
    "dev:setup": "npm run security:setup && npm run hooks:install",
    "test:clients": "node .github/scripts/smoke-clients.mjs",
    "test:cd": "node .github/scripts/rehearse-cd.mjs",
    "test:sync": "node --test tests/workbench-sync.test.mjs tests/workbench-inbox.test.mjs",
    "test:browser": "node tests/workbench-browser.mjs",
    "cloud:start": "node scripts/cloud/server.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
